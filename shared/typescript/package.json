{
  "name": "firmable-gtm-client",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Firmable REST client, credit budget, ledger, input and report helpers for gtm-starter-kit recipes.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./testing": "./dist/src/testing.js"
  },
  "bin": { "firmable-fixture-run": "dist/src/testing-cli.js" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b && node --test \"dist/tests/**/*.test.js\""
  }
}
