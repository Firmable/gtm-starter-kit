{
  "identifiers": {
    "company": { "column": "domain", "type": "fqdn" },
    "person": { "column": "work_email", "type": "work_email" }
  },
  "mappings": [
    { "column": "company_name", "source": "company", "field": "name" },
    { "column": "website", "source": "company", "field": "website", "compare_as": "domain" },
    { "column": "industry", "source": "company", "field": "industries" },
    { "column": "employee_count", "source": "company", "field": "employee_count" },
    { "column": "hq_location", "source": "company", "field": "hq_location" },
    { "column": "contact_name", "source": "person", "field": "name" },
    { "column": "contact_title", "source": "person", "field": "position" }
  ],
  "merge_policy": "fill_empty",
  "comparison": { "case_insensitive": true, "collapse_whitespace": true },
  "skip_dnd_phones": true
}
