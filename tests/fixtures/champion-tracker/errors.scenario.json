                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Their work email. Used to find them only; never stored or echoed",
                    "title": "Work Email"
                  },
                  "name": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "minLength": 2,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Optional: the person's name as you hold it; a mismatch gives unknown",
                    "title": "Name"
                  },
                  "company": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "minLength": 2,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
