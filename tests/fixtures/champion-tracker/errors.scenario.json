                      "type": "string"
                    },
                    "maxItems": 50,
                    "minItems": 1,
                    "title": "Companies",
                    "type": "array"
                  },
                  "include_current": {
                    "default": false,
                    "description": "Count their current employer too, including earlier roles there",
                    "title": "Include Current",
                    "type": "boolean"
                  }
                },
